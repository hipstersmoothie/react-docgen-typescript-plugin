{
  "include": ["src/**/*", "typings/**/*", "vitest.config.ts", "eslint.config.ts", "prettier.config.mjs"],

  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "rootDir": ".",
    "declaration": true,
    "importHelpers": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["esnext"],
    "target": "es2020",
    "skipLibCheck": true
  }
}
